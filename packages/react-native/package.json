{
  "name": "@flickerless/react-native",
  "version": "0.2.0",
  "description": "React Native surface, value and hook for Flickerless: loading without skeletons or full-screen spinners.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.tsx"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "dependencies": {
    "@flickerless/core": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.3.0",
    "react-native": "0.81.5",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuisMTaveras/flickerless.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/LuisMTaveras/flickerless#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
