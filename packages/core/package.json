{
  "name": "@flickerless/core",
  "version": "0.1.0",
  "description": "Framework-agnostic anti-flicker controller, CSS and optional Web Component for Flickerless data surfaces.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "sideEffects": [
    "./dist/element.js",
    "*.css"
  ],
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
