{
  "name": "@flickerless/core",
  "version": "0.1.0",
  "description": "Core framework-agnostic engine, Web Component, and CSS for Flickerless data surfaces.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT"
}
