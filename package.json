{
  "name": "flickerless",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-flicker, layout-stable data loading for tables, lists and dashboards. What stays stays; what is unknown is «—». The replacement for skeletons.",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "dev": "npm --workspace=playground run dev",
    "build": "npm --workspaces --if-present run build",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "npm --workspaces --if-present run test"
  },
  "keywords": [
    "skeleton-alternative",
    "data-table",
    "loading-state",
    "zero-cls",
    "keep-previous-data",
    "flickerless",
    "ui",
    "web-components",
    "react",
    "vue",
    "react-native"
  ],
  "author": "Luis M. Taveras <https://github.com/LuisMTaveras>",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  }
}
