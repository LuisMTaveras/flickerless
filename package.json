{
  "name": "flickerless",
  "version": "0.2.0",
  "private": true,
  "description": "Zero-flicker, layout-stable data loading for tables, lists and dashboards. What stays stays; what is unknown is «—». The replacement for skeletons.",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "pnpm -r --filter \"./packages/*\" --if-present test",
    "smoke": "node scripts/ssr-smoke.mjs",
    "release": "pnpm build && pnpm test && pnpm smoke && pnpm -r --filter \"./packages/*\" publish"
  },
  "keywords": [
    "skeleton-alternative",
    "data-table",
    "loading-state",
    "zero-cls",
    "keep-previous-data",
    "flickerless",
    "ui",
    "web-components",
    "react",
    "vue",
    "react-native"
  ],
  "author": "Luis M. Taveras <https://github.com/LuisMTaveras>",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vue": "^3.5.43"
  },
  "packageManager": "pnpm@10.28.0"
}
